
{% extends 'layouts/base.html.twig' %}

{% block title %}Contact - FleetManager{% endblock %}

{% block body %}

<main class="contact-container">

    <section class="contact-hero">

        <a href="{{ path('home') }}" class="contact-logo">
            <i class="fa-solid fa-truck-fast"></i>
            <span>Fleet<span class="contact-logo-highlight">Manager</span></span>
        </a>

        <div class="contact-hero-content">

            <span class="contact-badge">
                <i class="fa-solid fa-headset"></i>
                Notre équipe est à votre écoute
            </span>

            <h1>Parlons de votre <span>flotte automobile.</span></h1>

            <p>
                Une question sur nos fonctionnalités, nos abonnements ou
                la gestion de vos véhicules ? Notre équipe est là pour vous aider.
            </p>

            <div class="contact-info-list">

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div>
                        <h3>Envoyez-nous un e-mail</h3>
                        <a href="mailto:contact@fleetmanager.com">
                            contact@fleetmanager.com
                        </a>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>
                    <div>
                        <h3>Appelez-nous</h3>
                        <a href="tel:+261340000000">+261 34 00 000 00</a>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h3>Notre localisation</h3>
                        <p>Antananarivo, Madagascar</p>
                    </div>
                </div>

            </div>
        </div>

        <div class="contact-hero-footer">
            <i class="fa-solid fa-shield-halved"></i>
            Votre confiance est notre priorité.
        </div>

    </section>

    <section class="contact-form-section">

        <div class="contact-form-wrapper">

            <a href="{{ path('home') }}" class="contact-back-link">
                <i class="fa-solid fa-arrow-left"></i>
                Retour à l'accueil
            </a>

            <div class="contact-heading">
                <span class="contact-subtitle">CONTACTEZ-NOUS</span>
                <h2>Envoyez-nous un message</h2>
                <p>
                    Remplissez le formulaire ci-dessous.
                    Nous vous répondrons dans les meilleurs délais.
                </p>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, {
                'attr': {'class': 'contact-form'}
            }) }}

                <div class="contact-field-row">

                    <div class="contact-field">
                        <label for="{{ form.first_name.vars.id }}">Prénom</label>
                        {{ form_widget(form.first_name) }}
                        {{ form_errors(form.first_name) }}
                    </div>

                    <div class="contact-field">
                        <label for="{{ form.last_name.vars.id }}">Nom</label>
                        {{ form_widget(form.last_name) }}
                        {{ form_errors(form.last_name) }}
                    </div>

                </div>

                <div class="contact-field">

                    <label for="{{ form.email.vars.id }}">Adresse e-mail</label>

                    <div class="contact-input-icon">
                        <i class="fa-solid fa-envelope"></i>
                        {{ form_widget(form.email) }}
                    </div>

                    {{ form_errors(form.email) }}

                </div>

                <div class="contact-field">

                    <label for="{{ form.phone.vars.id }}">
                        Téléphone <span>(facultatif)</span>
                    </label>

                    <div class="contact-input-icon">
                        <i class="fa-solid fa-phone"></i>
                        {{ form_widget(form.phone) }}
                    </div>

                    {{ form_errors(form.phone) }}

                </div>

                <div class="contact-field">

                    <label for="{{ form.message.vars.id }}">Votre message</label>

                    {{ form_widget(form.message) }}

                    {{ form_errors(form.message) }}

                </div>

                <div class="contact-privacy">

                    {{ form_widget(form.info) }}

                    <label for="{{ form.info.vars.id }}">
                        J'accepte que mes informations soient utilisées
                        pour répondre à ma demande.
                    </label>

                </div>

                {{ form_errors(form.info) }}

                <button type="submit" class="contact-submit">
                    Envoyer le message
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

            {{ form_end(form) }}

            <div class="contact-security">
                <i class="fa-solid fa-lock"></i>
                Vos informations restent confidentielles.
            </div>

        </div>

    </section>

</main>

{% endblock %}
