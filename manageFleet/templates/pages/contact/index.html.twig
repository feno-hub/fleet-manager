{% extends 'layouts/base.html.twig' %}

{% block title %}FleetManager{% endblock %}

{% block body %}

    {# <div class="container">

        <nav class="home-nav">

            <a href="index.html" class="home-logo">
                <i class="fa-solid fa-truck-fast"></i>
                <span>Fleet<span>Manager</span></span>
