
{% extends 'layouts/admin.html.twig' %}

{% block title %}gestion des abonnements - FleetManager{% endblock %}
{% block page_title %}Gestion des abonnemnets{% endblock %}

{% block body %}

<div class="subscription-detail">

    <div class="detail-header">
        <div>
            <a href="{{ path('app.admin.subscription') }}" class="back-link">
                <i class="fas fa-arrow-left"></i>
                Retour aux abonnements
            </a>

            <span class="page-eyebrow">GESTION DES ABONNEMENTS</span>
            <h1>Détail de l'abonnement</h1>
            <p>Consultez les informations et le suivi de cet abonnement.</p>
        </div>
{# 
        <div class="header-actions">
            <a href="{{ path('admin_abonnement_edit', {id: 1}) }}" class="btn-edit">
                <i class="fas fa-pen"></i>
                Modifier
            </a>
            <button type="button" class="btn-print" onclick="window.print()">
                <i class="fas fa-print"></i>
                Imprimer
            </button>
        </div> #}
    </div>

    <div class="detail-overview">

        <div class="overview-main">
            <div class="overview-top">
                <div class="plan-icon">
                    <i class="fas fa-crown"></i>
                </div>

                <div>
                    <span class="plan-label">FORMULE SOUSCRITE</span>
                    <h2>Premium</h2>
                    <span class="status-badge status-active">
                        <span></span>
                        Actif
                    </span>
                </div>
            </div>

            <div class="overview-price">
                <h3>250 000 Ar <small>/ mois</small></h3>
                <p>Abonnement mensuel Premium</p>
            </div>

            <div class="overview-dates">
                <div>
                    <span>Date de début</span>
                    <strong>01 octobre 2026</strong>
                </div>

                <div>
                    <span>Date d'expiration</span>
                    <strong>01 novembre 2026</strong>
                </div>
            </div>
        </div>

        <div class="overview-side">
            <div class="side-heading">
                <i class="fas fa-chart-line"></i>
                <h3>État de l'abonnement</h3>
            </div>

            <div class="progress-info">
                <span>Période d'abonnement</span>
                <strong>29 jours restants</strong>
            </div>

            <div class="progress-bar">
                <div class="progress-value"></div>
            </div>

            <p class="progress-description">
                Cet abonnement est actuellement actif.
            </p>

            <div class="side-divider"></div>

            <div class="side-information">
                <span>Identifiant</span>
                <strong>#SUB-0001</strong>
            </div>

            <div class="side-information">
                <span>Type de paiement</span>
                <strong>Mobile Money</strong>
            </div>

            <div class="side-information">
                <span>Renouvellement</span>
                <strong>Automatique</strong>
            </div>
        </div>

    </div>

    <div class="detail-grid">

        <div class="detail-card company-detail">
            <div class="card-heading">
                <div class="heading-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h3>Informations de l'entreprise</h3>
                    <p>Informations sur l'entreprise abonnée.</p>
                </div>
            </div>

            <div class="company-profile">
                <div class="company-logo">T</div>
                <div>
                    <h3>Transport Mada</h3>
                    <span>Entreprise cliente</span>
                </div>
            </div>

            <div class="information-list">
                <div class="information-item">
                    <span>Nom de l'entreprise</span>
                    <strong>Transport Mada</strong>
                </div>

                <div class="information-item">
                    <span>Adresse e-mail</span>
                    <strong>contact@transportmada.mg</strong>
                </div>

                <div class="information-item">
                    <span>Téléphone</span>
                    <strong>+261 34 12 345 67</strong>
                </div>

                <div class="information-item">
                    <span>Adresse</span>
                    <strong>Antananarivo, Madagascar</strong>
                </div>

                <div class="information-item">
                    <span>Secteur d'activité</span>
                    <strong>Transport</strong>
                </div>

                <div class="information-item">
                    <span>Nombre de véhicules</span>
                    <strong>25 véhicules</strong>
                </div>
            </div>
        </div>

        <div class="detail-card plan-detail">
            <div class="card-heading">
                <div class="heading-icon purple">
                    <i class="fas fa-crown"></i>
                </div>
                <div>
                    <h3>Détails de la formule</h3>
                    <p>Fonctionnalités incluses dans l'offre.</p>
                </div>
            </div>

            <div class="plan-summary">
                <div>
                    <span>Formule</span>
                    <strong>Premium</strong>
                </div>
                <div>
                    <span>Tarification</span>
                    <strong>250 000 Ar / mois</strong>
                </div>
                <div>
                    <span>Durée</span>
                    <strong>30 jours</strong>
                </div>
            </div>

            <div class="features-list">
                <h4>Fonctionnalités incluses</h4>

                <div><i class="fas fa-check-circle"></i> Gestion de 50 véhicules</div>
                <div><i class="fas fa-check-circle"></i> Gestion des conducteurs</div>
                <div><i class="fas fa-check-circle"></i> Suivi des dépenses</div>
                <div><i class="fas fa-check-circle"></i> Gestion des maintenances</div>
                <div><i class="fas fa-check-circle"></i> Rapports et statistiques avancés</div>
                <div><i class="fas fa-check-circle"></i> Assistance prioritaire</div>
            </div>
        </div>

        <div class="detail-card payment-detail">
            <div class="card-heading">
                <div class="heading-icon green">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div>
                    <h3>Informations de paiement</h3>
                    <p>Détails de la transaction associée.</p>
                </div>
            </div>

            <div class="information-list">
                <div class="information-item">
                    <span>Montant payé</span>
                    <strong class="payment-amount">250 000 Ar</strong>
                </div>

                <div class="information-item">
                    <span>Méthode de paiement</span>
                    <strong>Mobile Money</strong>
                </div>

                <div class="information-item">
                    <span>Référence transaction</span>
                    <strong>TRX-2026-00125</strong>
                </div>

                <div class="information-item">
                    <span>Date de paiement</span>
                    <strong>01 octobre 2026</strong>
                </div>

                <div class="information-item">
                    <span>Statut du paiement</span>
                    <strong class="payment-status">
                        <i class="fas fa-check-circle"></i>
                        Payé
                    </strong>
                </div>
            </div>
        </div>

        <div class="detail-card history-detail">
            <div class="card-heading">
                <div class="heading-icon orange">
                    <i class="fas fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h3>Historique de l'abonnement</h3>
                    <p>Les événements liés à cet abonnement.</p>
                </div>
            </div>

            <div class="history-list">

                <div class="history-item">
                    <div class="history-icon success">
                        <i class="fas fa-check"></i>
                    </div>
                    <div>
                        <strong>Abonnement activé</strong>
                        <p>La formule Premium a été activée.</p>
                        <small>01 octobre 2026 à 09:30</small>
                    </div>
                </div>

                <div class="history-item">
                    <div class="history-icon blue">
                        <i class="fas fa-money-bill"></i>
                    </div>
                    <div>
                        <strong>Paiement confirmé</strong>
                        <p>Un paiement de 250 000 Ar a été reçu.</p>
                        <small>01 octobre 2026 à 09:25</small>
                    </div>
                </div>

                <div class="history-item">
                    <div class="history-icon purple">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <div>
                        <strong>Demande d'abonnement</strong>
                        <p>L'entreprise a choisi la formule Premium.</p>
                        <small>01 octobre 2026 à 09:10</small>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <div class="detail-footer">
        <div>
            <i class="fas fa-shield-halved"></i>
            <span>Gestion sécurisée des abonnements FleetManager</span>
        </div>

        <span>Dernière mise à jour : 01 octobre 2026</span>
    </div>

</div>


{% endblock %}
