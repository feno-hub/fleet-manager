
{% extends 'layouts/admin.html.twig' %}

{% block title %}gestion des abonnements - FleetManager{% endblock %}
{% block page_title %}Gestion des abonnemnets{% endblock %}

{% block body %}

<div class="subscription-page">

    <div class="subscription-header">
        <div>
            <span class="page-eyebrow">ADMINISTRATION</span>
            <h1>Gestion des abonnements</h1>
            <p>Gérez les formules, les renouvellements et les abonnements des entreprises.</p>
        </div>

        <a href="#subscription-table" class="btn-primary">
            <i class="fas fa-list"></i>
            Voir les abonnements
        </a>
    </div>

    <div class="subscription-stats">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-layer-group"></i>
            </div>
            <div>
                <span>Total abonnements</span>
                <h2>{{ totalSubscriptions|default(0) }}</h2>
                <small>Toutes les formules</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fas fa-circle-check"></i>
            </div>
            <div>
                <span>Actifs</span>
                <h2>{{ activeSubscriptions|default(0) }}</h2>
                <small>Abonnements en cours</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <span>En attente</span>
                <h2>{{ pendingSubscriptions|default(0) }}</h2>
                <small>À vérifier</small>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon red">
                <i class="fas fa-calendar-xmark"></i>
            </div>
            <div>
                <span>Expirés</span>
                <h2>{{ expiredSubscriptions|default(0) }}</h2>
                <small>À renouveler</small>
            </div>
        </div>
    </div>

    <div class="subscription-content">
        <div class="section-heading">
            <div>
                <h2>Liste des abonnements</h2>
                <p>Retrouvez et gérez les abonnements des entreprises inscrites.</p>
            </div>
        </div>

        <form method="get" action="{{ path('app.admin.subscription') }}"
              class="subscription-filters">

            <div class="search-field">
                <i class="fas fa-search"></i>
                <input
                    type="search"
                    name="search"
                    value="{{ search|default('') }}"
                    placeholder="Rechercher une entreprise..."
                >
            </div>

            <select name="plan">
                <option value="">Toutes les formules</option>
                <option value="Gratuit" {% if planActuel|default('') == 'Gratuit' %}selected{% endif %}>Gratuit</option>
                <option value="Standard" {% if planActuel|default('') == 'Standard' %}selected{% endif %}>Standard</option>
                <option value="Premium" {% if planActuel|default('') == 'Premium' %}selected{% endif %}>Premium</option>
            </select>

            <select name="status">
                <option value="">Tous les statuts</option>
                <option value="active" {% if statusActuel|default('') == 'active' %}selected{% endif %}>Actif</option>
                <option value="pending" {% if statusActuel|default('') == 'pending' %}selected{% endif %}>En attente</option>
                <option value="expired" {% if statusActuel|default('') == 'expired' %}selected{% endif %}>Expiré</option>
                <option value="cancelled" {% if statusActuel|default('') == 'cancelled' %}selected{% endif %}>Résilié</option>
            </select>

            <button type="submit" class="btn-filter">
                <i class="fas fa-filter"></i>
                Filtrer
            </button>

            <a href="{{ path('app.admin.subscription') }}" class="btn-reset">
                Réinitialiser
            </a>
        </form>

        <div class="subscription-table-wrapper" id="subscription-table">
            <table class="subscription-table">
                <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Formule</th>
                        <th>Prix</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
