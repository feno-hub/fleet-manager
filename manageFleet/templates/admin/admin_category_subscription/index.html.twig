
{% extends 'layouts/admin.html.twig' %}

{% block title %}gestion des abonnements - FleetManager{% endblock %}
{% block page_title %}Gestion des abonnemnets{% endblock %}

{% block body %}

    <div class="subscription-categories">

        <div class="page-header">
            <div>
                <h1>Catégories d'abonnement</h1>
                <p>Gérez les différentes offres proposées par FleetManager.</p>
            </div>

            <a href="{{ path('admin.subscription.new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                Ajouter une catégorie
            </a>
        </div>

        <div class="category-stats">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <span>Total des catégories</span>
                    <h2>{{ totalSubscription }} </h2>
                </div> 
            </div>

            <div class="stat-card">
                <div class="stat-icon active-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <span>Catégories actives</span>
                    <h2>{{ totalSubscriptionActive }} </h2>
                </div>
            </div>
        </div>

        <div class="category-card">
            <div class="table-header">
                <div>
                    <h2>Liste des catégories</h2>
                    <p>Retrouvez toutes les offres d'abonnement disponibles.</p>
                </div>

                <div class="category-search">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Rechercher une catégorie...">
                </div>
            </div>

            <div class="table-responsive">
                <table class="category-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Catégorie</th>
                            <th>Description</th>
                            <th>Prix mensuel</th>
                            <th>Durée</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for subscription in subscriptionCategories %}
                            <tr>
                                <td>0{{ subscription.id }} </td>
                                <td>
                                    <div class="category-name">
                                        <div class="category-icon free-icon">
                                            <i class="fas fa-leaf"></i>
                                        </div>
                                        <div>
                                            <strong>{{ subscription.name }} </strong>
                                            <small>Offre de découverte</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    {{ subscription.description|slice(0, 30) }} ...
                                </td>
                                <td class="price">{{ subscription.price }} Ar</td>
                                <td>{{ subscription.duration }} jours</td>
                                <td>
                                    {% if subscription.status == 'active' %}
                                        <span class="status status-active">Actif</span>
                                    {% else %}
                                        <span class="status status-inactive">Inactif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="#" class="action-btn view-btn" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="#" class="action-btn edit-btn" title="Modifier">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="#" class="action-btn delete-btn" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <span>Affichage de 1 à 3 sur 3 catégories</span>
            </div>
        </div>

    </div>

{% endblock %}
