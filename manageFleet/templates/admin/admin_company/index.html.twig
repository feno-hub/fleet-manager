
{% extends 'layouts/admin.html.twig' %}

{% block title %}Liste des entreprises - FleetManager{% endblock %}
{% block page_title %}Liste des entreprises{% endblock %}

{% block body %}
<section class="entreprises-page">

    <div class="entreprises-intro">
        <div>
            <span class="entreprises-eyebrow">GESTION DE LA PLATEFORME</span>
            <h2>Liste des entreprises</h2>
            <p>Consultez les comptes et suivez leur statut de validation.</p>
        </div>

        <div class="entreprises-total">
            <i class="fa-solid fa-building"></i>
            <div>
                <strong>{{ totalUser|length }}</strong>
                <span>Entreprises inscrites</span>
            </div>
        </div>
    </div>

    <div class="entreprises-panel">

        <div class="entreprises-panel-heading">
            <div>
                <h3>Toutes les entreprises</h3>
                <p>Filtrez les comptes selon leur statut.</p>
            </div>

            <form method="get"
                  action="{{ path('app_admin_company') }}"
                  class="entreprises-filter">

                <label for="status">Statut</label>

                <select id="status" name="status" onchange="this.form.submit()">
                    <option value="all" {% if currentStatus == 'all' %}selected{% endif %}>
                        Tous les statuts
                    </option>
                        <option value="pending" {% if currentStatus == 'pending' %}selected{% endif %}>
                            En attente
                        </option>
                        <option value="accepted" {% if currentStatus == 'accepted' %}selected{% endif %}>
                            Acceptées
                        </option>
                        <option value="reject" {% if currentStatus == 'reject' %}selected{% endif %}>
                            Refusées
                        </option>
                </select>
            </form>
        </div>

        <div class="entreprises-table-wrapper">
            <table class="entreprises-table">
                <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Responsable</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Date d'inscription</th>
                        <th>Statut</th>
                    </tr>
                </thead>

                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                <div class="entreprise-name">
                                    <span class="entreprise-avatar">
                                        {{ user.nameCompany|default('E')|first|upper }}
                                    </span>
                                    <div>
                                        <strong>{{ user.nameCompany|default('Entreprise sans nom') }}</strong>
                                        <small>
                                            {% if user.nif is defined and user.nif %}
                                                NIF : {{ user.nif }}
                                            {% else %}
                                                Compte entreprise
                                            {% endif %}
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                {{ user.firstName }}
                                {{ user.lastName }}
                            </td>

                            <td>{{ user.email }}</td>

                            <td>{{ user.phone|default('Non renseigné') }}</td>

                            <td>
                                {% if user.createdAt %}
                                    {{ user.createdAt|date('d/m/Y') }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>

                            <td>
                                {% if user.status == 'accepte' %}
                                    <span class="entreprise-status accepted">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Acceptée
                                    </span>
                                {% elseif user.status == 'en_attente' %}
                                    <span class="entreprise-status pending">
                                        <i class="fa-solid fa-clock"></i>
                                        En attente
                                    </span>
                                {% elseif user.status == 'refuse' %}
                                    <span class="entreprise-status rejected">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                        Refusée
                                    </span>
                                {% else %}
                                    <span class="entreprise-status unknown">
                                        {{ user.status|default('Non défini') }}
                                    </span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <div class="entreprises-empty">
                                    <i class="fa-solid fa-building-circle-exclamation"></i>
                                    <strong>Aucune entreprise trouvée</strong>
                                    <p>Aucune entreprise ne correspond à ce filtre.</p>
                                    {% if currentStatus != 'all' %}
                                        <a href="{{ path('app_admin_company') }}">
                                            Afficher toutes les entreprises
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="entreprises-footer">
            <span>{{ users|length }} résultat(s)</span>
            <a href="{{ path('app_admin_company') }}">
                <i class="fa-solid fa-rotate-right"></i>
                Réinitialiser les filtres
            </a>
        </div>

    </div>
</section>
{% endblock %}
